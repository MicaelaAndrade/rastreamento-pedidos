{
  "name": "rastreamento-pedidos",
  "image": "mcr.microsoft.com/devcontainers/java:1-21",
  "features": {
    "ghcr.io/devcontainers/features/java:1": {
      "version": "none",
      "installMaven": "true"
    },
    "ghcr.io/devcontainers/features/node:1": {
      "version": "22"
    }
  },
  "forwardPorts": [5173, 8080],
  "portsAttributes": {
    "5173": { "label": "Front-end", "onAutoForward": "openBrowser" },
    "8080": { "label": "API" }
  },
  "postCreateCommand": "cd frontend && npm ci && cd ../backend && mvn -q -B dependency:go-offline"
}
